# Origem permitida para chamadas ao backend (URL do frontend). Padrão: qualquer origem.
CORS_ORIGIN=http://localhost:5173

# Persistência. Em produção, configure estes valores no painel da Vercel, nunca no Git.
# DATA_STORE aceita memory (desenvolvimento/testes) ou supabase.
DATA_STORE=memory
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Apenas servidor e scripts administrativos; não use prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
